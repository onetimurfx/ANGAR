# Frontend (PUBLIC values only - they end up in the browser bundle).
# Set these as GitHub *Variables* (Settings > Secrets and variables > Actions > Variables) or in your host's build env.
# NEVER put the bot token, the service_role key or SESSION_SECRET here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional build-time fallback used only when no backend is configured (demo mode)
# VITE_DELIVERY_FEE=
# VITE_DELIVERY_FREE_FROM=
